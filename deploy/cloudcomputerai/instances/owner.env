# Owner instance (non-secret settings only; secrets live outside git).
CUSTOMER_SLUG=owner
APP_HOST=email.egorai.com
API_HOST=api.email.egorai.com
# Cookie scope must cover APP_HOST and API_HOST but no other instance.
COOKIE_DOMAIN=email.egorai.com
# Host-side ports on gex44-apps (127.0.0.1 only), unique per instance.
PG_PORT=15432
REDIS_HTTP_PORT=18079
# Shared Google OAuth relay (Phase 2). Owner keeps the default cookie prefix so nobody is logged out.
AUTH_RELAY_URL=https://auth.email.egorai.com
INSTANCE_SLUG=owner
